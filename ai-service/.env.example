# Model settings only. Infrastructure and AI_SERVICE_TOKEN come from root launcher.
# Leave blank for explicitly labelled retrieval-only operation.
AGENT_LLM_API_KEY=
AGENT_LLM_MODEL=
AGENT_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AGENT_EMBEDDING_MODEL=text-embedding-v3
AGENT_EMBEDDING_DIMENSIONS=1024
# Optional separate embedding provider; otherwise inherits chat API key/base URL.
AGENT_EMBEDDING_API_KEY=
AGENT_EMBEDDING_BASE_URL=
